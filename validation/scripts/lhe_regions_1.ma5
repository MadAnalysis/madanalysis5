#TITLE Analysis editing and resubmission
#MODE PARTON
# Requires region removal and remove/swap resubmission triggers.
# The final output must match lhe_regions_1_reference.ma5.
# Run this script only on a branch implementing those commands.

import samples/ttbar_sl_1.lhe.gz as testset
set main.normalize = none
set main.lumi = 1.0
define lep = e+ e- mu+ mu-

# Remove the last region and its exclusive histogram/cut. No selections
# should remain, and neither selection may become global.
define_region temporary
plot MET 40 0 200 {temporary}
select MET < 0 {temporary}
remove temporary
display selection
display_regions

define_region keep control discard

# Keep the numbered declarations stable: edits below use these indices.
plot MET 40 0 200
# 1: common histogram
select MET > 20
# 2: common cut
select N(lep) >= 1
# 3: common cut
plot MET 40 0 200 {discard}
# 4: exclusive histogram
select MET > 40 {discard}
# 5: exclusive cut
plot PT(lep[1]) 40 0 200 {discard}
# 6: exclusive histogram
select MET < 0
# 7: deliberately rejects every region
plot MET 40 0 200 {keep control}
# 8: shared final histogram

# Initial output: every final histogram is empty.
submit

# Each edit is followed by resubmit separately, so one working trigger
# cannot mask another missing trigger. First restore surviving events.
remove selection[7]
resubmit

# Change intermediate cutflow counters while preserving the final yield.
swap selection[2] selection[3]
resubmit

# Remove consecutive exclusive selections and trim shared associations.
remove discard
display selection
display_regions
resubmit
